      "css": ".ds-themes{display:flex;gap:8px}.ds-theme{display:flex;align-items:center;gap:8px;min-height:40px;flex:1;padding:8px 12px;background:none;color:var(--ink,#2c251f);font:400 11px var(--ui,Archivo,Arial,sans-serif);border:1px solid var(--rule,#cfc6b5);border-radius:5px;cursor:pointer;transition:background-color .18s,transform .18s}.ds-selected{border-color:var(--ink,#2c251f);background:#f6f1e450}.ds-swatch{width:14px;height:14px;border:1px solid #b8aa96;border-radius:50%;background:var(--paper,#f6f1e4)}.ds-night{background:#211c18}.ds-theme:hover{background:#f6f1e450}.ds-theme:focus-visible{outline:2px solid var(--red,#b92d40);outline-offset:4px}.ds-theme:active{transform:translateY(1px)}"
