      "html": "<button class=\"ds-primary\">Entrar en escena <svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 12h16m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:30px;min-height:52px;padding:0 24px;background:var(--ink,#2c251f);color:var(--paper,#f6f1e4);font:500 13px var(--ui,Archivo,Arial,sans-serif);border:0;border-radius:5px;cursor:pointer;transition:background-color .18s,color .18s,transform .18s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-primary:hover:not(:disabled){background:var(--red-dark,#922235)}.ds-primary:focus-visible{outline:2px solid var(--red,#b92d40);outline-offset:4px}.ds-primary:active:not(:disabled){transform:translateY(1px)}.ds-primary:disabled{opacity:.4;cursor:not-allowed}"
    },
    {
      "name": "Acción de texto",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Acciones secundarias junto a un icono de línea.",
      "html": "<button class=\"ds-text\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 6C8 3 4 4 2 5v14c4-2 7-1 10 1m0-14c4-3 8-2 10-1v14c-4-2-7-1-10 1V6Z\"/></svg> Mi contenido</button>",
      "css": ".ds-text{display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:0;border:0;background:none;color:var(--ink,#2c251f);font:400 12px var(--ui,Archivo,Arial,sans-serif);cursor:pointer;transition:color .18s,transform .18s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-text:hover{color:var(--red,#b92d40)}.ds-text:focus-visible{outline:2px solid var(--red,#b92d40);outline-offset:4px}.ds-text:active{transform:translateY(1px)}"
    },
    {
      "name": "Acción de icono",
      "kind": "button",
      "refersTo": "button-icon",
      "description": "Control circular con etiqueta accesible.",
      "html": "<button class=\"ds-icon\" aria-label=\"Ajustes de escena\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 7h16M4 17h16M9 4v6M15 14v6\"/></svg></button>",
      "css": ".ds-icon{display:inline-flex;align-items:center;justify-content:center;width:44px;height:44px;border:0;border-radius:50%;background:none;color:var(--ink,#2c251f);cursor:pointer;transition:background-color .18s,transform .18s var(--ease,cubic-bezier(.16,1,.3,1))}.ds-icon:hover{background:#2c251f09}.ds-icon:focus-visible{outline:2px solid var(--red,#b92d40);outline-offset:4px}.ds-icon:active{transform:translateY(1px)}"
    },
    {
      "name": "Campo de mensaje",
      "kind": "input",
      "refersTo": "input-text",
