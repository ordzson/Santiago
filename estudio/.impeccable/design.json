      "html": "<label class=\"ds-field-label\" for=\"ds-end\">Mensaje final</label><input class=\"ds-input\" id=\"ds-end\" type=\"text\" value=\"Es todo por hoy.\" maxlength=\"100\">",
      "css": ".ds-field-label{display:block;margin:22px 0 10px;color:var(--ink,#2c251f);font:400 11px var(--ui,Archivo,Arial,sans-serif)}.ds-input{width:100%;min-height:48px;background:transparent;border:1px solid var(--rule,#cfc6b5);padding:10px 14px;border-radius:6px;color:var(--ink,#2c251f);caret-color:var(--red,#b92d40);font-family:var(--ui,Archivo,Arial,sans-serif)}.ds-input:hover{border-color:var(--rule,#cfc6b5)}.ds-input:focus-visible{outline:2px solid var(--red,#b92d40);outline-offset:4px}"
    },
    {
      "name": "Opción de recorrido",
      "kind": "custom",
      "refersTo": "mode-option",
      "description": "Modo seleccionado en la lista de preparación.",
      "html": "<button class=\"ds-mode\" aria-pressed=\"true\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 6C8 3 4 4 2 5v14c4-2 7-1 10 1m0-14c4-3 8-2 10-1v14c-4-2-7-1-10 1V6Z\"/></svg><span>Un libro<small>De principio a fin</small></span><span class=\"ds-check\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m5 12 4 4 10-10\"/></svg></span></button>",
      "css": ".ds-mode{display:grid;grid-template-columns:26px 1fr 22px;gap:12px;align-items:center;width:100%;min-height:68px;padding:14px 6px;text-align:left;border:0;border-top:1px solid var(--rule,#cfc6b5);border-bottom:1px solid var(--rule,#cfc6b5);background:none;color:var(--red,#b92d40);font:500 13px var(--ui,Archivo,Arial,sans-serif);cursor:pointer;transition:background-color .18s,transform .18s}.ds-mode small{display:block;margin-top:4px;color:var(--muted,#6e6458);font-size:10px;font-weight:400}.ds-check{display:flex}.ds-mode:hover{background:#f6f1e460}.ds-mode:focus-visible{outline:2px solid var(--red,#b92d40);outline-offset:4px}.ds-mode:active{transform:translateY(1px)}"
